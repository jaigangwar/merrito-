PORT=3001
JWT_SECRET=replace-with-a-long-random-secret

# Real data mode
REAL_DATA_MODE=true
USE_DEMO_DATA=false
SEED_DEMO_USERS=false
VITE_SHOW_DEMO_LOGIN=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public lead webhook protection
WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Optional AI and communication providers
# (For OpenAI, leave Base URL default. For Groq, use: https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
INSTITUTE_NAME=RBMI Admissions

# Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
